{
  "name": "alya",
  "version": "1.0.3",
  "description": "ALYA - Asistente IA personal",
  "main": "out/main.js",
  "author": "Andres",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "publish": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "auto-launch": "^5.0.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.23.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.andres.alya",
    "productName": "ALYA",
    "publish": {
      "provider": "github",
      "owner": "MiguelAndresGuerrero",
      "repo": "ALYA",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName} Setup.${ext}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "piper",
        "to": "piper"
      },
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "extensions",
        "to": "extensions"
      }
    ]
  }
}